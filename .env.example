# Ejemplo de variables de entorno para Docker Compose en desarrollo.
# Copiar como `.env` (NO va a git). En producción se define un .env real en el servidor.
# Usar `docker compose config` para verificar que aporta lo esperado.

# Contraseña del superusuario de la base de datos de desarrollo (cambiarla por una única para tu equipo).
POSTGRES_PASSWORD=aeteme_dev_password

# Puerto del contenedor PostgreSQL publicado en el host; dejar 5432 si está libre.
# Si ya tenés PostgreSQL instalado en el host, usar 5433 para evitar conflicto.
POSTGRES_PORT=5432
